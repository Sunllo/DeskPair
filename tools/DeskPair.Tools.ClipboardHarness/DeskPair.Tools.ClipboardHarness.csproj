<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Description>Manual verification of the macOS and Linux clipboards, which have no automated tests because both need a real desktop session.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both portable platform projects. Which one is used is decided at run time, so this publishes
         self-contained to a machine that has no .NET at all — which is exactly the case on the Mac. -->
    <ProjectReference Include="..\..\src\DeskPair.Platform.MacOS\DeskPair.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\src\DeskPair.Platform.Linux\DeskPair.Platform.Linux.csproj" />
  </ItemGroup>

</Project>
