<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeskPair.Desktop.ViewModels"
             xmlns:loc="using:DeskPair.Desktop.Localization"
             x:Class="DeskPair.Desktop.Views.ConnectionHistoryView"
             x:DataType="vm:ConnectionHistoryViewModel">
  <DockPanel Margin="24,0,24,18">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="{loc:Loc history.title}" Classes="h1" />
      <TextBlock Text="{loc:Loc history.subtitle}" Classes="hint" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button Content="{loc:Loc history.refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="{loc:Loc history.clear}" Command="{Binding ClearCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
      <CheckBox IsChecked="{Binding Uploads}" Content="{loc:Loc history.upload}" Margin="0,4,0,0" />
      <TextBlock Text="{loc:Loc history.uploadHint}" Classes="hint" Margin="26,0,0,0" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Problem}" Foreground="#E8917C" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{loc:Loc history.empty}" Foreground="#8A929E" Margin="0,4,0,0" IsVisible="{Binding IsEmpty}" />
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectionHistoryRow">
            <Border Background="#1B1F24" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Foreground="#E6EAF0" />
                    <TextBlock Text="{Binding Status}" Foreground="#E8C06A" VerticalAlignment="Center" FontSize="12"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Detail}" Foreground="#9AA4B2" FontSize="12.5" TextWrapping="Wrap"
                             IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding Allowed}" Foreground="#6F7885" FontSize="12" TextWrapping="Wrap"
                             IsVisible="{Binding Allowed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="#8A929E" FontSize="12"
                           VerticalAlignment="Top" Margin="12,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
