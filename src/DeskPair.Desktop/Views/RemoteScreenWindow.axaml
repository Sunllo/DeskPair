<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeskPair.Desktop.ViewModels"
        xmlns:loc="using:DeskPair.Desktop.Localization"
        xmlns:controls="using:DeskPair.Desktop.Controls"
        Icon="/Assets/deskpair.ico"
        x:Class="DeskPair.Desktop.Views.RemoteScreenWindow"
        x:DataType="vm:RemoteScreenViewModel"
        Title="{Binding Title}"
        Background="#101010"
        Width="1280" Height="800">
  <DockPanel>
    <!--
      A thin bar, deliberately: quality, sound, recording and the rest are the session's, and stay on its tab.
      This window only frames its own picture.
    -->
    <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="8,3">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding Title}" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ToggleButton IsChecked="{Binding FitToWindow}" Content="{loc:Loc session.fit}" IsEnabled="{Binding !IsFollowing}" />
        <Button Command="{Binding RefreshCommand}" Content="⟳" ToolTip.Tip="{loc:Loc screen.refresh}" />
        <Button Command="{Binding ShowSessionCommand}" Content="{loc:Loc screen.showSession}" />
        <TextBlock Text="{Binding MatchWindowStatus}" VerticalAlignment="Center" Foreground="#E8C06A"
                   IsVisible="{Binding MatchWindowStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>
    <!-- The session's connection status (latency, bitrate, path), shared from the owning session so a display
         pulled out into its own window still shows how the link is doing. -->
    <Border DockPanel.Dock="Bottom" Background="#161616" Padding="10,3" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
            IsVisible="{Binding Owner.RttText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Owner.RttText}" Foreground="#9C9" FontSize="12" VerticalAlignment="Center" />
    </Border>
    <ScrollViewer x:Name="DisplayScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
      <controls:RemoteDisplayView x:Name="Display" />
    </ScrollViewer>
  </DockPanel>
</Window>
