<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeskPair.Desktop.ViewModels"
             xmlns:controls="using:DeskPair.Desktop.Controls"
             xmlns:views="using:DeskPair.Desktop.Views"
             xmlns:loc="using:DeskPair.Desktop.Localization"
             x:Class="DeskPair.Desktop.Views.RemoteSessionView"
             x:DataType="vm:RemoteSessionViewModel"
             Background="#101010">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="8,4">
      <!-- The scrollbar in a row of its own, below the buttons, when the toolbar is wider than the window. Laid over
           them, as Avalonia does by default, it covered the lower half of every button and took its clicks: in English
           the toolbar is wider than a 1200-pixel window. -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{loc:Loc session.display}" VerticalAlignment="Center" Foreground="#CCC" />
          <ComboBox ItemsSource="{Binding Displays}" SelectedIndex="{Binding CurrentDisplay}" MinWidth="120" />
          <!-- Another of the host's displays in a window of its own, for the viewer's own second screen. -->
          <Button x:Name="DisplayWindowButton" Content="⧉" IsVisible="{Binding CanOpenDisplayWindows}" IsEnabled="{Binding HasWindowChoices}"
                  ToolTip.Tip="{loc:Loc session.openDisplayWindow}" />
          <!-- A display the host does not have, sized like the viewer's own screen; it opens in a window of its own. -->
          <Button x:Name="AddDisplayButton" Content="＋" IsVisible="{Binding CanAddDisplays}" IsEnabled="{Binding !PrivateScreenOn}"
                  ToolTip.Tip="{Binding AddDisplayTip}" ToolTip.ShowOnDisabled="True" />
          <Button Content="{loc:Loc session.removeDisplay}" Command="{Binding RemoveDisplayCommand}" IsVisible="{Binding CurrentDisplayIsAdded}" />
          <ComboBox ItemsSource="{Binding Resolutions}" SelectedIndex="{Binding ResolutionIndex}" MinWidth="130"
                    IsVisible="{Binding CanChangeResolution}" IsEnabled="{Binding !IsFollowing}" ToolTip.Tip="{loc:Loc session.resolution}" />
          <TextBlock Text="{loc:Loc session.quality}" VerticalAlignment="Center" Foreground="#CCC" Margin="8,0,0,0" />
          <ComboBox SelectedIndex="{Binding QualityIndex}" MinWidth="100">
            <ComboBoxItem Content="{loc:Loc session.quality.low}" />
            <ComboBoxItem Content="{loc:Loc session.quality.balanced}" />
            <ComboBoxItem Content="{loc:Loc session.quality.best}" />
            <ComboBoxItem Content="{loc:Loc settings.quality.custom}" />
          </ComboBox>
          <TextBlock Text="{loc:Loc settings.fps}" VerticalAlignment="Center" Foreground="#CCC" Margin="8,0,0,0" />
          <ComboBox ItemsSource="{Binding FrameRates}" SelectedIndex="{Binding FrameRateIndex}" MinWidth="80"
                    ToolTip.Tip="{loc:Loc session.frameRate.tip}" />
          <ToggleButton IsChecked="{Binding TranslateMode}" Content="{loc:Loc session.keyboard.translate}" ToolTip.Tip="{loc:Loc session.keyboardMode}" />
          <ToggleButton IsChecked="{Binding FitToWindow}" Content="{loc:Loc session.fit}" IsEnabled="{Binding !IsFollowing}" />
          <!-- The remote display the size of this window, as a Windows remote desktop session is; Fit and the picker wait meanwhile. -->
          <ToggleButton IsChecked="{Binding MatchWindow}" Content="{loc:Loc session.matchWindow}" ToolTip.Tip="{loc:Loc session.matchWindow.tip}" />
          <TextBlock Text="{Binding MatchWindowStatus}" VerticalAlignment="Center" Foreground="#E8C06A"
                     IsVisible="{Binding MatchWindowStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ToggleButton IsChecked="{Binding ShowRemoteCursor}" Content="🖱" ToolTip.Tip="{loc:Loc session.remoteCursor}" />
          <ToggleButton IsChecked="{Binding AudioEnabled}" Content="{loc:Loc session.audio}" />
          <Button Command="{Binding CtrlAltDelCommand}" Content="{loc:Loc session.ctrlAltDel}" />
          <Button Command="{Binding LockCommand}" Content="{loc:Loc session.lock}" />
          <Button Command="{Binding RefreshCommand}" Content="⟳" />
          <ToggleButton IsChecked="{Binding ChatVisible}" Content="{loc:Loc session.chat}" />
          <Button Command="{Binding OpenFilesCommand}" Content="{loc:Loc session.files}" x:Name="FilesButton" />
          <Button Command="{Binding OpenTerminalCommand}" Content="{loc:Loc terminal.open}" />
          <ToggleButton IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding ToggleRecordingCommand}"
                        Content="⏺" Foreground="#F05A5A" ToolTip.Tip="{loc:Loc session.record}" />
          <TextBlock Text="{Binding RecordingText}" VerticalAlignment="Center" Foreground="#E8C06A" />
          <Button Command="{Binding DisconnectCommand}" Content="{loc:Loc session.disconnect}" Background="#7A2E2E" />
        </StackPanel>
      </ScrollViewer>
    </Border>
    <!-- Connection status on a line of its own, so it is always visible: in the toolbar it sat past the right edge
         and the horizontal scrollbar, where a user never found it. -->
    <Border DockPanel.Dock="Bottom" Background="#161616" Padding="10,3" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"
            IsVisible="{Binding RttText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding RttText}" Foreground="#9C9" FontSize="12" VerticalAlignment="Center" />
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="DisplayScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <controls:RemoteDisplayView x:Name="Display" />
      </ScrollViewer>
      <Border Grid.Column="1" Width="300" Background="#1A1A1A" IsVisible="{Binding ChatVisible}" BorderBrush="#333" BorderThickness="1,0,0,0">
        <views:ChatView DataContext="{Binding Chat}" />
      </Border>
      <!--
        A stall is not a close: the session is still open and usually comes back, so the last picture stays
        where it is and the notice sits over it. Dimming or replacing the picture would throw away the one
        thing the user still has to work from.
      -->
      <Border Grid.ColumnSpan="2" IsVisible="{Binding IsStalled}" VerticalAlignment="Top" HorizontalAlignment="Center"
              Background="#E6241A1A" BorderBrush="#7A3A3A" BorderThickness="1" CornerRadius="0,0,8,8" Padding="16,9"
              BoxShadow="0 4 16 0 #66000000">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Loc session.stalled}" Foreground="#F0C8C8" VerticalAlignment="Center" FontWeight="SemiBold" />
          <TextBlock Text="{loc:Loc session.stalledHint}" Foreground="#A89090" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </Border>
      <!-- The remote computer is on a desktop DeskPair cannot read: a UAC prompt on the secure desktop, or the
           lock screen. The last picture stays put, out of date, and this says why over it. -->
      <Border Grid.ColumnSpan="2" IsVisible="{Binding HasSecureDesktopNotice}" VerticalAlignment="Top" HorizontalAlignment="Center"
              Background="#E62A2410" BorderBrush="#7A6A3A" BorderThickness="1" CornerRadius="0,0,8,8" Padding="16,9"
              BoxShadow="0 4 16 0 #66000000">
        <StackPanel Orientation="Horizontal" Spacing="12" MaxWidth="660">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding SecureDesktopNotice}" Foreground="#F0E0C0" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ElevationStatus}" IsVisible="{Binding HasElevationStatus}" Foreground="#C8B890" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Button Content="{loc:Loc session.elevation.request}" IsVisible="{Binding CanRequestElevation}"
                  Command="{Binding RequestElevationCommand}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <!-- A host with no screen: the session is fine, there is just nothing to draw. When the host said why (a
           Wayland desktop whose person has not allowed sharing yet), its words replace "no screen". -->
      <Border Grid.ColumnSpan="2" IsVisible="{Binding HasNoDisplays}" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="#E6202428" BorderBrush="#3A424A" BorderThickness="1" CornerRadius="8" Padding="20,14" MaxWidth="560">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Loc session.noDisplays}" IsVisible="{Binding !HasHostNotice}" Foreground="#E6EAF0" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding HostNotice}" IsVisible="{Binding HasHostNotice}" Foreground="#E6EAF0" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{loc:Loc session.noDisplaysHint}" Foreground="#9AA4B2" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.ColumnSpan="2" Background="#CC101010" IsVisible="{Binding ShowOverlay}">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#2A2A2A" CornerRadius="8" Padding="28" MinWidth="360">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Target}" FontSize="20" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="{Binding Status}" Foreground="#CCC" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <StackPanel IsVisible="{Binding NeedsPassword}" Spacing="8">
              <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{loc:Loc session.password}" x:Name="PasswordBox"
                       InputMethod.IsInputMethodEnabled="False" TextInputOptions.ContentType="Password" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" Foreground="#F66" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{loc:Loc session.cancel}" Command="{Binding CancelCommand}" />
              <Button Content="{loc:Loc session.login}" Command="{Binding LoginCommand}" IsVisible="{Binding NeedsPassword}" IsDefault="True" Classes="accent" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
