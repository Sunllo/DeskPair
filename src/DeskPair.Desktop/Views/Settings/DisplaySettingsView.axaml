<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DeskPair.Desktop.ViewModels.Settings"
             xmlns:loc="using:DeskPair.Desktop.Localization"
             x:Class="DeskPair.Desktop.Views.Settings.DisplaySettingsView"
             x:DataType="vm:DisplaySettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10" MaxWidth="600" HorizontalAlignment="Left">
      <TextBlock Text="{loc:Loc settings.tab.display}" Classes="title" />
      <TextBlock Text="{loc:Loc settings.displayIntro}" Classes="hint" TextWrapping="Wrap" />

      <TextBlock Text="{loc:Loc settings.whenConnecting}" Classes="section" Margin="0,8,0,0" />
      <TextBlock Text="{loc:Loc settings.defaultQuality}" Classes="label" />
      <ComboBox SelectedIndex="{Binding QualityIndex}" MinWidth="200">
        <ComboBoxItem Content="{loc:Loc session.quality.low}" />
        <ComboBoxItem Content="{loc:Loc session.quality.balanced}" />
        <ComboBoxItem Content="{loc:Loc session.quality.best}" />
        <ComboBoxItem Content="{loc:Loc settings.quality.custom}" />
      </ComboBox>
      <StackPanel Spacing="4" IsVisible="{Binding IsCustomQuality}">
        <Grid ColumnDefinitions="Auto,12,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc settings.bitrate}" Classes="label" />
            <TextBox Text="{Binding CustomBitrateKbps.Text}" Width="120" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="{loc:Loc settings.fps}" Classes="label" />
            <TextBox Text="{Binding CustomFps.Text}" Width="100" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding CustomBitrateKbps.Problem}" Classes="problem" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CustomFps.Problem}" Classes="problem" TextWrapping="Wrap" />
      </StackPanel>
      <CheckBox IsChecked="{Binding ShowRemoteCursor}" Content="{loc:Loc settings.showCursor}" />
      <CheckBox IsChecked="{Binding LosslessRefinement}" Content="{loc:Loc settings.lossless}" />
      <CheckBox IsChecked="{Binding FitToWindow}" Content="{loc:Loc settings.fitToWindow}" />
      <CheckBox IsChecked="{Binding MatchWindowResolution}" Content="{loc:Loc settings.matchWindow}" />
      <TextBlock Text="{loc:Loc settings.matchWindowHint}" Classes="hint" TextWrapping="Wrap" Margin="28,-6,0,0" />
      <CheckBox IsChecked="{Binding SmoothPlayback}" Content="{loc:Loc settings.smoothPlayback}" />

      <TextBlock Text="{loc:Loc settings.thisComputer}" Classes="section" Margin="0,14,0,0" />
      <TextBlock Text="{loc:Loc settings.codec}" Classes="label" />
      <ComboBox SelectedIndex="{Binding CodecIndex}" MinWidth="200">
        <ComboBoxItem Content="{loc:Loc settings.codec.auto}" />
        <ComboBoxItem Content="H.264" />
        <ComboBoxItem Content="H.265" />
        <ComboBoxItem Content="AV1" />
        <ComboBoxItem Content="VP9" />
      </ComboBox>

      <!-- Displays this computer does not have, plugged in for a viewer; Windows only. -->
      <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding VirtualDisplaysApply}">
        <CheckBox IsChecked="{Binding AllowVirtualDisplay}" Content="{loc:Loc settings.allowVirtualDisplay}" />
        <TextBlock Text="{loc:Loc settings.allowVirtualDisplayHint}" Classes="hint" TextWrapping="Wrap" />
        <CheckBox IsChecked="{Binding PrivateSessionScreen}" Content="{loc:Loc settings.allowSessionScreen}" />
        <TextBlock Text="{loc:Loc settings.allowSessionScreenHint}" Classes="hint" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DriverStatus}" Classes="label" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Loc settings.displayDriver.install}" Command="{Binding InstallDisplayDriverCommand}" IsVisible="{Binding !DriverInstalled}" />
          <Button Content="{loc:Loc settings.displayDriver.remove}" Command="{Binding RemoveDisplayDriverCommand}" IsVisible="{Binding DriverInstalled}" />
        </StackPanel>
        <TextBlock Text="{Binding DriverNotice}" Classes="hint" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
