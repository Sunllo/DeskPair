<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskPair.Desktop.App"
             Name="DeskPair"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DeskPair/Assets/PlatformIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2E6BD6" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- The account at the foot of the navigation rail: a target to click, not a button to notice. -->
    <Style Selector="Button.account">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.account:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#20262E" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#8A929E" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#8A929E" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.problem">
      <Setter Property="Foreground" Value="#E88" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
