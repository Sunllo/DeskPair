<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Linux implementation of the platform contracts (in progress).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeskPair.Platform.Linux.Tests" />
    <!-- pipewire-grab reads a PipeWire node through the shim and the capturer without a portal (tools/wayland-ci). -->
    <InternalsVisibleTo Include="DeskPair.Tools.LinuxHarness" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskPair.Platform.Abstractions\DeskPair.Platform.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pseudo-terminal code both Unix systems share; internal to each assembly, so the two copies never meet. -->
    <Compile Include="..\Shared\UnixTerminal\*.cs" Link="Terminal\Unix\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
